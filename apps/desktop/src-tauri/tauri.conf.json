{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joy",
  "version": "0.1.0",
  "identifier": "com.joy.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @joy/web dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @joy/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joy",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4317 ws://127.0.0.1:4317; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first coding agent platform",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": false,
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
